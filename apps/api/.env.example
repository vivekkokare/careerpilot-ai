# ============================================================================
# career-ops API — Environment Variables
# Copy to .env and fill in values. Never commit .env.
# ============================================================================

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | production | test
PORT=3001
API_BASE_URL=http://localhost:3001

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Full connection string. Prisma uses this via datasource env("DATABASE_URL").
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL=postgresql://career_ops:career_ops_dev@localhost:5432/career_ops?schema=public

# ── Redis (BullMQ job queue) ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
# JWT secret — used to sign API tokens issued to the browser extension and mobile.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_EXPIRY=30d

# Auth mode:
#   none   → single implicit local user, no sign-in required (default for local installs)
#   jwt    → JWT Bearer tokens (cloud / multi-user)
CAREER_OPS_AUTH=none

# ── Encryption ────────────────────────────────────────────────────────────────
# AES-256-GCM key for OAuth token storage.
# Must be exactly 32 bytes (256 bits) encoded as hex (64 hex chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_KEY

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins for CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Requests per window per IP. Increase for trusted internal networks.
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
RATE_LIMIT_MAX=200

# ── career-ops Project Root ───────────────────────────────────────────────────
# Absolute path to the career-ops project directory.
# The API shells out to scripts (set-status.mjs, merge-tracker.mjs, etc.)
# using this as the working directory.
CAREER_OPS_ROOT=/path/to/career-ops

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info    # error | warn | info | http | debug
LOG_FORMAT=json   # json (production) | pretty (development)

# ── AI Assistant ─────────────────────────────────────────────────────────────
# Anthropic API key — required for the AI Assistant feature (7 analysis modes).
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Model used for assistant analysis. Defaults to claude-sonnet-4-6.
# ASSISTANT_MODEL=claude-sonnet-4-6

# ── Google OAuth (Sheets + Gmail sync) ───────────────────────────────────────
# Required when SHEETS_ENABLED=true.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback

# ── Google Sheets Sync ────────────────────────────────────────────────────────
SHEETS_ENABLED=false
# SHEETS_SPREADSHEET_ID=             # Google Sheet ID (from URL)
# SHEETS_TAB_NAME=Applications       # Tab name inside the spreadsheet
# SHEETS_HEADER_ROW=1                # 1-indexed row containing column headers
# SHEETS_DATA_START_ROW=2            # First data row (after header)
# SHEETS_AUTO_SYNC=true              # Auto-enqueue on application CRUD
# SHEETS_SYNC_INTERVAL_MS=300000     # Periodic full-sync interval (5 min)
# SHEETS_MAX_RETRIES=5               # Max retry attempts per job
# SHEETS_RETRY_BASE_DELAY_MS=1000    # Initial retry backoff (exponential)
# SHEETS_CONFLICT_STRATEGY=local_wins # local_wins | remote_wins | manual

# API base URL — proxied by Vite in dev, set to full URL in production
VITE_API_URL=http://localhost:3001

# Auth mode — must match the API's CAREER_OPS_AUTH value
# none → no login screen, local single-user mode
# jwt  → show login screen, use JWT Bearer tokens
VITE_AUTH_MODE=none

# App metadata
VITE_APP_NAME=career-ops
VITE_APP_VERSION=1.0.0
